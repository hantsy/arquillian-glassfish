<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

  <parent>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>arquillian-glassfish-tests</artifactId>
  <name>Arquillian Container GlassFish Integration Tests 7.x</name>
  <description>Integration tests for GlassFish Managed and Remote container adapters</description>

  <properties>
    <glassfish.home>${project.build.directory}/glassfish7</glassfish.home>
    <cargo.container.id>glassfish7x</cargo.container.id>
  </properties>

  <dependencies>
    <!-- Container adapter implementations are added per-profile to avoid
         Multiple DeployableContainer implementations on classpath -->

    <!-- Arquillian JUnit5 container -->
    <dependency>
      <groupId>org.jboss.arquillian.junit5</groupId>
      <artifactId>arquillian-junit5-container</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ShrinkWrap Maven resolver -->
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JUnit Jupiter -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- jakarta.inject -->
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Surefire runs unit tests; we skip it (all tests are integration tests) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <!-- Failsafe runs integration tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- GlassFish 7.x Managed (active by default) -->
    <profile>
      <id>glassfish-managed</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.github.hantsy.arquillian</groupId>
          <artifactId>arquillian-glassfish-managed</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <testResources>
          <testResource>
            <directory>src/test/resources</directory>
          </testResource>
          <testResource>
            <directory>src/test/resources/arq-glassfish-managed</directory>
          </testResource>
        </testResources>
        <plugins>
          <!-- Download and unpack GlassFish for managed tests -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>setup-glassfish</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.glassfish.main.distributions</groupId>
                      <artifactId>glassfish</artifactId>
                      <version>${glassfish.version}</version>
                      <type>zip</type>
                      <outputDirectory>${project.build.directory}</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- Pass system properties to failsafe -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <glassfish.home>${glassfish.home}</glassfish.home>
                <enableDerby>false</enableDerby>
                <arquillian.launch>glassfish-managed</arquillian.launch>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- GlassFish Remote -->
    <profile>
      <id>glassfish-remote</id>
      <dependencies>
        <dependency>
          <groupId>io.github.hantsy.arquillian</groupId>
          <artifactId>arquillian-glassfish-remote</artifactId>
          <version>${project.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <testResources>
          <testResource>
            <directory>src/test/resources</directory>
          </testResource>
          <testResource>
            <directory>src/test/resources/arq-glassfish-remote</directory>
          </testResource>
        </testResources>
        <plugins>
          <!-- Start/Stop GlassFish via Cargo artifactInstaller -->
          <plugin>
            <groupId>org.codehaus.cargo</groupId>
            <artifactId>cargo-maven3-plugin</artifactId>
            <version>1.10.26</version>
            <configuration>
              <container>
                <containerId>${cargo.container.id}</containerId>
                <artifactInstaller>
                  <groupId>org.glassfish.main.distributions</groupId>
                  <artifactId>glassfish</artifactId>
                  <version>${glassfish.version}</version>
                </artifactInstaller>
              </container>
              <configuration>
                <properties>
                  <cargo.servlet.port>8080</cargo.servlet.port>
                  <cargo.glassfish.admin.password>adminadmin</cargo.glassfish.admin.password>
                </properties>
              </configuration>
            </configuration>
            <executions>
              <execution>
                <id>start-glassfish</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>start</goal>
                </goals>
              </execution>
              <execution>
                <id>stop-glassfish</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!-- Pass system properties to failsafe -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <arquillian.launch>glassfish-remote</arquillian.launch>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- GlassFish 8.x version override -->
    <profile>
      <id>glassfish8</id>
      <properties>
        <glassfish.version>8.0.4</glassfish.version>
        <glassfish.home>${project.build.directory}/glassfish8</glassfish.home>
        <cargo.container.id>glassfish8x</cargo.container.id>
      </properties>
    </profile>
  </profiles>
</project>
